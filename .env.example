# ===== Global =====
NODE_ENV=development
LOG_LEVEL=info

# ===== API =====
API_PORT=4000
API_HOST=0.0.0.0

# ===== Web =====
WEB_PORT=5173

# ===== Worker =====
WORKER_POLL_INTERVAL_MS=5000

# ===== Core Runtime =====
DB_PATH=../../data/medical.db
QUEUE_MODE=sqlite
QUEUE_NAME=task-execution
SCHEDULER_INTERVAL_MS=10000
SCHEDULER_STALE_THRESHOLD_MS=30000

# ===== Infra / Integrations (placeholders) =====
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/medical

# TODO: 依 DESIGN.md 的 Auth/Plugin/Monitoring 模組，在後續子任務補齊對應金鑰與服務端點。
